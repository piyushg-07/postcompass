{
  "name": "postcompass",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web --filter=docs --filter=server --filter=@repo/ui",
    "dev:web": "turbo run dev --filter=web --filter=docs --filter=server --filter=@repo/ui",
    "dev:desktop": "turbo run dev --filter=desktop",
    "dev:server": "turbo run dev --filter=server",
    "dev:all": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
