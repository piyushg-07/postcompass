{
  "name": "postcompass",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web --filter=@repo/ui",
    "dev:web": "turbo run dev --filter=web --filter=@repo/ui",
    "dev:desktop": "turbo run dev --filter=desktop",
    "dev:all": "turbo run dev",
    "build:app": "pnpm --filter desktop build:app",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "rust:check": "cargo clippy --workspace --all-targets",
    "rust:test": "cargo test --workspace",
    "rust:fmt": "cargo fmt --all"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  }
}
