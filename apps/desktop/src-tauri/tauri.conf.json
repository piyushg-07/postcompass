{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PostCompass",
  "mainBinaryName": "PostCompass",
  "version": "0.1.1",
  "identifier": "com.postcompass.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PostCompass",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true,
        "backgroundColor": "#020202"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "PostCompass",
    "copyright": "© 2026 PostCompass",
    "category": "DeveloperTool",
    "shortDescription": "A modern desktop app for PostgreSQL",
    "longDescription": "PostCompass is a fast, modern desktop app for PostgreSQL. Install and run local databases in one click, connect to cloud databases (AWS RDS, Google Cloud SQL, Azure, DigitalOcean, Neon and more), browse and edit tables, write SQL with explain plans, explore ER diagrams, and back up or restore databases.",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "displayLanguageSelector": false
      },
      "wix": {
        "bannerPath": "icons/wix-banner.bmp",
        "dialogImagePath": "icons/wix-dialog.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1RkM5NTk2ODFGNDQwQTUKUldTbFFQU0JscFg4bGUxL052VU1hd29yeU11OVlGcFdQL2RuOUJCRWI3eTk3M1dsNU8zTzIvOEMK",
      "endpoints": [
        "https://github.com/piyushg-07/postcompass/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
